generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model lead {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  firstName   String
  lastName    String
  email       String
  jobTitle    String?
  countryCode String?
  companyName String?
  message     String?
  /// null = email has never been verified. See src/leads/emailVerificationStatus.ts for allowed transitions.
  emailVerificationStatus EmailVerificationStatus?
  phoneNumber String?
  yearsAtCompany Int?
  linkedinUrl String?
  companyWebsite String?
}

enum EmailVerificationStatus {
  PENDING
  VERIFIED
  INVALID
  FAILED
}
