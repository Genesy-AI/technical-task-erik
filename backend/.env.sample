# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#using-environment-variables

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server and MongoDB (Preview).
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="mysql://root:password@localhost:3306/express?schema=public"

# API server
PORT=4000

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=myQueue

# Phone enrichment providers (copy this file to .env; the API loads it on startup)
ORION_CONNECT_API_KEY=mySecretKey123
ASTRA_DIALER_API_KEY=1234jhgf
NIMBUS_LOOKUP_API_KEY=000099998888
# Optional base URL overrides (e.g. to point at a stub server in tests)
# ORION_CONNECT_URL=https://api.enginy.ai/api/tmp/orionConnect
# ASTRA_DIALER_URL=https://api.enginy.ai/api/tmp/astraDialer
# NIMBUS_LOOKUP_URL=https://api.enginy.ai/api/tmp/numbusLookup
# Optional max requests/second per provider (unset = unlimited), enforced via Temporal task-queue rate limits
# ORION_CONNECT_MAX_RPS=5
# ASTRA_DIALER_MAX_RPS=10
# NIMBUS_LOOKUP_MAX_RPS=5
